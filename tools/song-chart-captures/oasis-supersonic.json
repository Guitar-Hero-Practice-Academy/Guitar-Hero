    {
      "name": "Notes",
      "rows": [
        {
          "type": "lyrics",
          "page": 1,
          "fragments": [
            {
              "text": "This is the simple acoustic version when using a capo.",
              "sourceX": 0.092402
            }
          ]
        },
        {
          "type": "lyrics",
          "page": 1,
          "fragments": [
            {
              "text": "The capo should be on the second fret.",
              "sourceX": 0.092402
            }
          ]
        },
        {
          "type": "lyrics",
          "page": 1,
          "fragments": [
            {
              "text": "With this method, there is no need for bar chords.",
              "sourceX": 0.092402
            }
          ]
        },
        {
          "type": "lyrics",
          "page": 1,
          "fragments": [
            {
              "text": "This was made by ear.",
              "sourceX": 0.092402
            }
          ]
        },
        {
          "type": "lyrics",
          "page": 1,
          "fragments": [
            {
              "text": "It should be easy for novices, as all chords are rather simple, apart from the B7,",
              "sourceX": 0.092402
            }
          ]
        },
        {
          "type": "lyrics",
          "page": 1,
          "fragments": [
            {
              "text": "which may take a little getting used to.",
              "sourceX": 0.092402
            }
          ]
        }
      ]
